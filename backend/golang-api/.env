# VMS Environment Configuration

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vms_user
DB_PASSWORD=vms_password
DB_NAME=vms_db

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# JWT Configuration (for future use)
JWT_SECRET=vms_jwt_secret_key_2024
JWT_EXPIRATION=24h

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Log Configuration
LOG_LEVEL=info
LOG_FILE=logs/vms-api.log

# OpenClaw Agent API Key (for POST /api/webhook/agent authentication)
